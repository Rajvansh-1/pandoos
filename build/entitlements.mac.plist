<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- Allow JIT compilation (needed by Electron's V8) -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <!-- Allow unsigned executable memory (required by Electron) -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <!-- Allow dyld environment variables (needed for Electron's node integration) -->
    <key>com.apple.security.cs.allow-dyld-environment-variables</key>
    <true/>
    <!-- Disable library validation so Electron can load its own native modules -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <!-- Network access — needed to stream music and check for updates -->
    <key>com.apple.security.network.client</key>
    <true/>
    <!-- Audio output — needed to play music -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
  </dict>
</plist>
